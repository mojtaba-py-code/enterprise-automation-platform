# Copy to .env and fill in. Never commit the real .env. All keys are prefixed EAP_.

EAP_APP_NAME="Enterprise Automation Platform"
EAP_ENVIRONMENT=development          # development | test | staging | production
EAP_DEBUG=true
EAP_API_PREFIX=/api/v1

# --- security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EAP_SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
EAP_JWT_ALGORITHM=HS256
EAP_ACCESS_TOKEN_TTL=900
EAP_REFRESH_TOKEN_TTL=604800
EAP_CORS_ORIGINS=http://localhost:3000
EAP_RATE_LIMIT_PER_MINUTE=120

# --- persistence ---
EAP_DATABASE_URL=postgresql+asyncpg://eap:eap@localhost:5432/eap
EAP_REDIS_URL=redis://localhost:6379/0

# --- automation runtime ---
EAP_WORKSPACE_DIR=./workspace
EAP_DEFAULT_STEP_TIMEOUT=30
EAP_DEFAULT_STEP_RETRIES=2
EAP_HTTP_TIMEOUT_SECONDS=15
